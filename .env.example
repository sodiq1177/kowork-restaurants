# Database (SQLite)
DATABASE_URL="file:./dev.db"

# NextAuth
AUTH_SECRET="your-secret-here-run-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Cloudinary
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# OpenStreetMap / Nearby search
# No API key required for the default OSM Overpass + Nominatim queries.

# Yandex Maps (optional)
NEXT_PUBLIC_YANDEX_MAPS_API_KEY="your-yandex-key"
